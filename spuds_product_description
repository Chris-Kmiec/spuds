8) Data Model (SQL-ish, MVP)
-- Users
CREATE TABLE users (
  id UUID PRIMARY KEY,
  email TEXT UNIQUE NOT NULL,
  display_name TEXT,
  city TEXT,
  lat DOUBLE PRECISION,
  lng DOUBLE PRECISION,
  bio TEXT,
  avatar_url TEXT,
  platforms TEXT[],            -- ["PC","PS5","Switch","Xbox","Tabletop"]
  games TEXT[],                -- freeform tags
  rating_avg NUMERIC(3,2) DEFAULT 0,
  rating_count INT DEFAULT 0,
  created_at TIMESTAMPTZ DEFAULT now()
);

-- Parties
CREATE TABLE parties (
  id UUID PRIMARY KEY,
  host_id UUID REFERENCES users(id),
  title TEXT NOT NULL,
  description TEXT,
  start_time TIMESTAMPTZ NOT NULL,
  end_time TIMESTAMPTZ,
  city TEXT NOT NULL,
  address TEXT NOT NULL,       -- masked until RSVP accepted
  lat DOUBLE PRECISION,
  lng DOUBLE PRECISION,
  capacity INT NOT NULL,
  slots_taken INT DEFAULT 0,
  vibe TEXT[],                 -- ["Chill","Competitive","Co-op","Beginner-friendly"]
  games TEXT[],                -- ["Smash Ultimate","Mario Kart 8", "Catan"]
  platforms TEXT[],            -- ["Switch","PC","PS5","Tabletop"]
  byo_gear BOOLEAN DEFAULT FALSE,
  alcohol_free BOOLEAN DEFAULT FALSE,
  min_age INT DEFAULT 18,
  join_policy TEXT CHECK (join_policy IN ('auto','approve')) DEFAULT 'approve',
  status TEXT CHECK (status IN ('published','cancelled','completed')) DEFAULT 'published',
  created_at TIMESTAMPTZ DEFAULT now()
);

-- RSVPs
CREATE TABLE rsvps (
  id UUID PRIMARY KEY,
  party_id UUID REFERENCES parties(id),
  user_id UUID REFERENCES users(id),
  status TEXT CHECK (status IN ('pending','accepted','declined','cancelled')) DEFAULT 'pending',
  message TEXT,                -- short intro from guest
  created_at TIMESTAMPTZ DEFAULT now(),
  UNIQUE (party_id, user_id)
);

-- Messages (event chat)
CREATE TABLE party_messages (
  id UUID PRIMARY KEY,
  party_id UUID REFERENCES parties(id),
  sender_id UUID REFERENCES users(id),
  body TEXT NOT NULL,
  created_at TIMESTAMPTZ DEFAULT now()
);

-- Ratings (post-event)
CREATE TABLE ratings (
  id UUID PRIMARY KEY,
  party_id UUID REFERENCES parties(id),
  rater_id UUID REFERENCES users(id),
  ratee_id UUID REFERENCES users(id),
  stars INT CHECK (stars BETWEEN 1 AND 5),
  comment TEXT,
  created_at TIMESTAMPTZ DEFAULT now()
);

-- Reports (safety/moderation)
CREATE TABLE reports (
  id UUID PRIMARY KEY,
  reporter_id UUID REFERENCES users(id),
  party_id UUID REFERENCES parties(id),
  reported_user_id UUID REFERENCES users(id),
  reason TEXT,
  created_at TIMESTAMPTZ DEFAULT now(),
  resolved BOOLEAN DEFAULT FALSE
);

9) API Contracts (REST, JSON; MVP)

Auth

POST /api/auth/magic-link → { email } → 200 { ok: true }

POST /api/auth/verify → { token } → 200 { jwt, user }

Discover

GET /api/parties?lat&lng&radius=25&start=2025-09-29&game=...&platform=...&vibe=...
→ 200 { results: PartyCard[], nextCursor }

Party detail

GET /api/parties/:id → 200 PartyDetail

Host create/edit

POST /api/parties → 201 { id }

PATCH /api/parties/:id → 200 { updated: true }

DELETE /api/parties/:id → 204

RSVPs

POST /api/parties/:id/rsvps → { message } → 200 { status: 'pending'|'accepted' }

PATCH /api/rsvps/:id (host approve/deny) → { status } → 200

GET /api/parties/:id/rsvps (host) → 200 { rsvps: [...] }

Messaging (party thread)

GET /api/parties/:id/messages → 200 { messages: [...] }

POST /api/parties/:id/messages → { body } → 201

Ratings/Reports

POST /api/parties/:id/ratings → { stars, comment } → 201

POST /api/parties/:id/reports → { reason, reported_user_id? } → 201

Types (abbreviated)

type PartyCard = {
  id: string; title: string; start_time: string; city: string;
  lat: number; lng: number; distance_mi?: number;
  games: string[]; platforms: string[]; vibe: string[];
  capacity: number; slots_taken: number; host: HostLite;
};

type PartyDetail = PartyCard & {
  description?: string; min_age: number; byo_gear: boolean; alcohol_free: boolean;
  address_masked: boolean; address?: string; join_policy: 'auto'|'approve';
  attendees: UserLite[];
};

type UserLite = { id: string; display_name: string; rating_avg?: number; rating_count?: number; avatar_url?: string; }
type HostLite = UserLite;

10) Tech Stack (simple + no-code-friendly choices)

Frontend: Next.js (App Router), TypeScript, Tailwind CSS, Mapbox GL JS

Backend: Next.js API routes or lightweight Node/Express (hosted on Vercel/Render)

DB/Auth/File storage: Supabase (Postgres + RLS, Auth, Storage)

Email: Resend or Supabase email for magic links

Maps/Geo: Mapbox (forward geocoding for city to lat/lng)

Payments (later): Stripe (cost-share/host tips)

Analytics: PostHog or Plausible

Image hosting: Supabase Storage

Why: Supabase simplifies auth + DB (you’re not a coder), Next.js/Vercel makes deploys one-click, and this stack is “MVP-friendly.”

11) Security & Privacy (MVP rules)

Show only city/approximate area to non-attendees; reveal full address after accepted RSVP.

Required email verification; optional SMS verification.

Basic rate limiting for party creation and messaging.

Report and ban endpoints; admin can unpublish parties.

12) Moderation Guidelines (UI copy shortcuts)

Prohibited: hate speech, harassment, illegal activities, minors.

Noise/quiet hours respect. Alcohol rules must be explicit if applicable.

One strike for serious offenses; 3 cumulative minor strikes → ban.

