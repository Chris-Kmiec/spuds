# Supabase — create a project at https://supabase.com/dashboard (or run `supabase start` for local dev)
# Local dev uses http://127.0.0.1:44321 (ports moved out of Windows' reserved ranges — see README)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — Mapbox token for the discover map (Phase 2)
NEXT_PUBLIC_MAPBOX_TOKEN=
